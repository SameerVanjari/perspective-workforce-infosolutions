# Perspectives Workforce — environment configuration (template)
#
# Copy this file to `.env` and fill in real values, then run:
#   node scripts/generate-config.js
#
# This generates js/config.js (which is gitignored) so secrets never enter git.

# Google Apps Script Web App URL — receives contact-form submissions and
# appends them to your Google Sheet (see google-apps-script.gs).
# Deploy the script as: Execute as Me / Who has access: Anyone.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
